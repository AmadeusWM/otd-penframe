{
  "name": "otd-penframe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/package.mjs",
    "bundle": "pnpm build && node scripts/archive.mjs",
    "build:shell-test": "tsc -p tsconfig.shell-test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint extension tests scripts",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@girs/gjs": "4.9.0",
    "@girs/gnome-shell": "50.0.4",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
